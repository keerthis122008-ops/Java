import java.util.Scanner;

class Student {
    int rollNo;
    String name;
    String department;
    int age;
    String college;
    String email;
    long phone;
    int mark1, mark2, mark3;
    int total;
    double average;

    // Constructor
    Student(int rollNo, String name, String department,
            int age, String college, String email,
            long phone, int mark1, int mark2, int mark3) {

        this.rollNo = rollNo;
        this.name = name;
        this.department = department;
        this.age = age;
        this.college = college;
        this.email = email;
        this.phone = phone;
        this.mark1 = mark1;
        this.mark2 = mark2;
        this.mark3 = mark3;
    }

    // Method to calculate total and average
    void calculate() {
        total = mark1 + mark2 + mark3;
        average = total / 3.0;
    }

    // Method to display student details
    void display() {
        calculate();

        System.out.println("\n========== STUDENT DETAILS ==========");
        System.out.println("Roll Number : " + rollNo);
        System.out.println("Name        : " + name);
        System.out.println("Department  : " + department);
        System.out.println("Age         : " + age);
        System.out.println("College     : " + college);
        System.out.println("Email       : " + email);
        System.out.println("Phone       : " + phone);

        System.out.println("\n---------- MARK DETAILS ----------");
        System.out.println("Mark 1      : " + mark1);
        System.out.println("Mark 2      : " + mark2);
        System.out.println("Mark 3      : " + mark3);
        System.out.println("Total Marks : " + total);
        System.out.println("Average     : " + average);
        System.out.println("======================================");
    }
}

public class StudentDetails {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("STUDENT INFORMATION SYSTEM");
        System.out.println("--------------------------");

        System.out.print("Enter Roll Number: ");
        int rollNo = sc.nextInt();
        sc.nextLine();

        System.out.print("Enter Student Name: ");
        String name = sc.nextLine();

        System.out.print("Enter Department: ");
        String department = sc.nextLine();

        System.out.print("Enter Age: ");
        int age = sc.nextInt();
        sc.nextLine();

        System.out.print("Enter College Name: ");
        String college = sc.nextLine();

        System.out.print("Enter Email ID: ");
        String email = sc.nextLine();

        System.out.print("Enter Phone Number: ");
        long phone = sc.nextLong();

        System.out.print("Enter Mark 1: ");
        int mark1 = sc.nextInt();

        System.out.print("Enter Mark 2: ");
        int mark2 = sc.nextInt();

        System.out.print("Enter Mark 3: ");
        int mark3 = sc.nextInt();

        Student s = new Student(
            rollNo, name, department, age,
            college, email, phone,
            mark1, mark2, mark3
        );

        s.display();

        sc.close();
    }
}
